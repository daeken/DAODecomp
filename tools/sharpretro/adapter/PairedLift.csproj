<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireSharpRetroRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SharpRetroRoot)' == ''" Text="Set -p:SharpRetroRoot to the pinned SharpRetro checkout path." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(SharpRetroRoot)/XFusionCpu/XFusionCpu.csproj" />
  </ItemGroup>
</Project>
