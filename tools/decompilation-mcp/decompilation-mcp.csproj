<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Decompilation.Mcp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="[2.2.0]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.10]" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.13]" />
    <None Include="replayable_adapter.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="replayable_transport.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="adapter.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
